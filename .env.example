# n8n-tt-outpost Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
FEATURE_STAGE=MVP_MANUAL
ENABLE_F5_PUBLISHER=false
ENABLE_REAL_PROVIDER_CALLS=false
TIMEZONE=Asia/Jakarta

# =============================================================================
# PostgreSQL Database
# =============================================================================
# Use a dedicated database for n8n-tt-outpost
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/n8n_tt_outpost
# Or individual components:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=n8n_tt_outpost

# Connection pool settings
PG_POOL_MIN=2
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# =============================================================================
# Nemotron Model Adapter
# =============================================================================
# NVIDIA API or local vLLM/OpenAI-compatible endpoint
NEMOTRON_BASE_URL=http://localhost:8000/v1
NEMOTRON_API_KEY=your-nemotron-api-key-here

# Model profile (selected via capability probe at runtime)
# NEMOTRON_MODEL_ID=nemotron-3-ultra
# NEMOTRON_SERVING_ENGINE=vllm
# NEMOTRON_TIMEOUT_SECONDS=30
# NEMOTRON_TEMPERATURE=0
# NEMOTRON_TOP_P=1
# NEMOTRON_MAX_OUTPUT_TOKENS=4096

# =============================================================================
# Telegram Bot
# =============================================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook
TELEGRAM_ALLOWLIST=123456789,987654321

# =============================================================================
# Artifact Storage
# =============================================================================
# Local filesystem storage path (absolute)
ARTIFACT_STORAGE_PATH=./data/artifacts
# Retention settings
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_DOWNLOAD_EXPIRY_HOURS=24

# =============================================================================
# Logging & Observability
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REDACT_SECRETS=true

# =============================================================================
# Scheduler & Queue (F4+)
# =============================================================================
SCHEDULER_ENABLED=false
QUEUE_CONCURRENCY=3
QUEUE_LEASE_TTL_SECONDS=300
QUEUE_MAX_RETRIES=3

# =============================================================================
# Publisher (F5+)
# =============================================================================
PUBLISHER_ENABLED=false
TIKTOK_ADAPTER_ENABLED=false
INSTAGRAM_ADAPTER_ENABLED=false
FACEBOOK_ADAPTER_ENABLED=false
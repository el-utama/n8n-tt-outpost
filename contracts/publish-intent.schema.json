{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n8n-tt-outpost.local/schemas/publish-intent.schema.json",
  "title": "PublishIntent",
  "type": "object",
  "required": ["publish_intent_id", "job_id", "content_package_id", "user_id", "account_id", "mode", "policy_profile_id", "platforms", "status", "created_at", "updated_at"],
  "properties": {
    "publish_intent_id": {"type": "string", "format": "uuid"},
    "job_id": {"type": "string", "format": "uuid"},
    "content_package_id": {"type": "string", "format": "uuid"},
    "user_id": {"type": "string"},
    "account_id": {"type": "string"},
    "mode": {"type": "string", "enum": ["MANUAL", "SEMI_AUTO", "FULL_AUTO"]},
    "policy_profile_id": {"type": ["string", "null"], "format": "uuid"},
    "batch_id": {"type": ["string", "null"], "format": "uuid"},
    "approval_id": {"type": ["string", "null"], "format": "uuid"},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["tiktok", "instagram", "facebook"]}},
    "intended_schedule": {"type": ["string", "null"], "format": "date-time"},
    "idempotency_key": {"type": "string"},
    "status": {"type": "string", "enum": ["DRAFT", "PENDING_APPROVAL", "APPROVED", "PREFLIGHT", "READY_TO_PUBLISH", "UPLOADING", "PUBLISHED", "PARTIAL_FAILURE", "FAILED_RETRYABLE", "FAILED_FINAL", "STOPPED", "CANCELLED"]},
    "platform_status": {"type": "object", "additionalProperties": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
